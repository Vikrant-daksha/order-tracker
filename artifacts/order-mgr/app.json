{
  "expo": {
    "name": "OrderFlow",
    "slug": "order-mgr",
    "owner": "vikrant_05",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "scheme": "order-mgr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vikrant05.orderflow"
    },
    "android": {
      "package": "com.vikrant05.orderflow",
      "versionCode": 5,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.jpg",
        "backgroundColor": "#F8BCCD"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.jpg",
          "color": "#F8BCCD",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OrderFlow to access your photos to attach product images.",
          "cameraPermission": "Allow OrderFlow to take product photos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "ndkVersion": "27.1.12297006",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b503bb4-6de4-4b1d-8ebb-eb61896b15c7"
      }
    }
  }
}
